# FacturasMX — Fase 3b

# --- Base de datos ---
# Supabase: Project Settings → Database → Connection string (URI).
# SQLAlchemy usa psycopg3; el prefijo postgresql:// se normaliza solo.
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Cliente Supabase (opcional, solo si usas supabase-py además de SQLAlchemy)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGc...
SUPABASE_SERVICE_KEY=eyJhbGc...

# --- JWT ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM (OpenAI) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6

# --- WhatsApp (Meta Cloud API) ---
# developers.facebook.com → tu app → WhatsApp → API Setup
WHATSAPP_TOKEN=EAAxxxxx...                      # access token (descargar media + enviar mensajes)
WHATSAPP_VERIFY_TOKEN=un-string-que-tu-inventas  # solo para el handshake GET de verificación
WHATSAPP_APP_SECRET=tu-app-secret-de-meta        # firma HMAC del webhook — NO es el verify token
WHATSAPP_PHONE_NUMBER_ID=1234567890              # requerido para enviar mensajes
WHATSAPP_BUSINESS_ACCOUNT_ID=9876543210

# --- App ---
DEBUG=True
YEAR_DEFAULT=2026
